#!/usr/bin/env bash
set -euo pipefail

# ── constants ────────────────────────────────────────────────────────────────
PAGEWORKS_VERSION="0.4.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TODAY="$(date +%Y-%m-%d)"

# ── helpers ──────────────────────────────────────────────────────────────────
die()  { echo "Error: $*" >&2; exit 1; }
info() { echo "$*"; }
skip() { echo "  ⊘  $*"; }
created() { echo "  ✓  $*"; }
filled() { echo "  ✓  $* (filled empty stub)"; }

require_value() {
  local flag="$1"
  local val="${2:-}"
  [[ -n "$val" ]] || die "$flag requires a value"
  [[ "$val" != -* ]] || die "$flag requires a value (got '$val' — looks like another flag)"
}

is_empty_file() {
  local path="$1"
  [[ ! -s "$path" ]] && return 0
  ! grep -q '[^[:space:]]' "$path" 2>/dev/null
}

in_list() {
  local needle="$1" haystack="$2"
  local IFS=$' \t\n'
  for item in $haystack; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

slug_from_dir() {
  basename "$(pwd)" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/--*/-/g' | sed 's/^-//;s/-$//'
}

write_if_missing() {
  local path="$1"; shift
  if [[ -e "$path" ]]; then
    if is_empty_file "$path"; then
      printf '%s' "$*" > "$path"
      filled "$path"
    else
      skip "$path"
    fi
  else
    mkdir -p "$(dirname "$path")"
    printf '%s' "$*" > "$path"
    created "$path"
  fi
}

# ── usage ────────────────────────────────────────────────────────────────────
top_usage() {
  cat <<EOF
pageworks v${PAGEWORKS_VERSION} — public-facing software & platform documentation

Usage: pageworks <command> [options]

CLI verbs (mutate docs/):
  init [opts]                         Scaffold docs/ + docs.yaml + index.md + sections
                                       --minimal           docs.yaml + index.md only
                                       --preset <name>     default | platform | minimal
                                       --platform          Alias for --preset platform (6 categories)
                                       --name <slug>       Override project name
  export <renderer> [opts]            Generate renderer config from docs.yaml
                                       Renderers: mkdocs | docusaurus | mintlify
                                       Options:
                                         --out <path>   Override default output location
                                         --force        Overwrite existing files
                                         --no-workflow  Skip GitHub Pages workflow
  doctor [--fix]                      Validate docs/ — schema, frontmatter, links, freshness, depth
                                       --fix applies mechanical repairs
  touch <page>                        Update last_reviewed timestamp to today (acknowledge freshness)

Skill verbs (run via /pageworks in your AI agent):
  new <page>                          Scaffold a page (asks for class format + section)
  new --section <name>                Declare a new section in docs.yaml
  review                              Quality gate — type fit, prose, structure, freshness
  status                              Briefing of docs/ state & topic inventory
  audit                               Drift detection — 180-day stale pages, broken links, sync

The 6 Core Classes of Pages:
  tutorial | how-to | adr | reference | service-catalog | postmortem (plus explanation)

The 6 Main Topic Categories:
  getting-started | architecture | services | operations | reference | standards

Top-level:
  -v, --version          Print version and exit
  -h, --help             Show this help

Docs: https://github.com/alexsmedile/pageworks
EOF
}

# ── docs init ────────────────────────────────────────────────────────────────
cmd_init() {
  local minimal=false
  local preset="default"
  local project_name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --minimal) minimal=true; preset="minimal"; shift ;;
      --platform) preset="platform"; shift ;;
      --preset)  require_value "--preset" "${2:-}"; preset="$2"; shift 2 ;;
      --preset=*) preset="${1#--preset=}"; shift ;;
      --name)    require_value "--name" "${2:-}"; project_name="$2"; shift 2 ;;
      --name=*)  project_name="${1#--name=}"; shift ;;
      -h|--help) top_usage; exit 0 ;;
      *) die "Unknown init option: '$1'" ;;
    esac
  done

  [[ "$preset" == "minimal" ]] && minimal=true
  [[ -z "$project_name" ]] && project_name="$(slug_from_dir)"

  echo "pageworks init"
  echo ""

  if [[ ! -d "docs" ]]; then
    mkdir -p docs
    created "docs/"
  else
    skip "docs/ (already exists)"
  fi

  local manifest_content
  if [[ "$preset" == "platform" ]]; then
    manifest_content="site:
  name: ${project_name}
  tagline: \"Software & platform documentation\"
  # base_url: https://example.com   # optional — used by renderer adapters

sections:
  - id: getting-started
    title: Getting Started
    order: 1
    pages: [install, quickstart, concepts]

  - id: architecture
    title: Architecture & System Design
    order: 2
    pages: []

  - id: services
    title: Services & Components
    order: 3
    pages: []

  - id: operations
    title: Operations & Reliability
    order: 4
    pages: []

  - id: reference
    title: API & Data Reference
    order: 5
    pages: []

  - id: standards
    title: Standards & Governance
    order: 6
    pages: []

# Optional top-level entries with no section grouping
# extras:
#   - changelog       # symlinks to ../CHANGELOG.md
#   - troubleshooting

# Optional per-renderer hints consumed by 'pageworks export <renderer>'
# renderers:
#   mkdocs:
#     theme: material
#     primary: indigo
#     repo_url: https://github.com/org/${project_name}
#     edit_uri: edit/main/docs/
#   docusaurus:
#     preset: classic
#     organizationName: org
#     projectName: ${project_name}
"
  else
    manifest_content="site:
  name: ${project_name}
  tagline: \"\"
  # base_url: https://example.com   # optional — used by renderer adapters

sections:
  - id: getting-started
    title: Getting Started
    order: 1
    pages: [install, quickstart, concepts]

  - id: guides
    title: Guides
    order: 2
    pages: []

  - id: reference
    title: Reference
    order: 3
    pages: []

# Optional top-level entries with no section grouping
# extras:
#   - changelog       # symlinks to ../CHANGELOG.md
#   - troubleshooting

# Optional per-renderer hints, consumed by 'pageworks export <renderer>'.
# Each adapter falls back to its built-in defaults if a key is absent.
# Full schema: pageworks references/renderers.md
# renderers:
#   mkdocs:
#     theme: material
#     primary: indigo
#     repo_url: https://github.com/org/${project_name}
#     edit_uri: edit/main/docs/
#   docusaurus:
#     preset: classic
#     organizationName: org
#     projectName: ${project_name}
"
  fi

  write_if_missing "docs/docs.yaml" "$manifest_content"

  write_if_missing "docs/index.md" "---
title: ${project_name}
description: User-facing software & platform documentation for ${project_name}.
section: \"\"
type: explanation
order: 0
status: draft
owner: \"@platform-core\"
last_reviewed: ${TODAY}
updated: ${TODAY}
---

# ${project_name}

Welcome to the documentation. Start here, then drill into the sections below.

## System Overview & Ownership

| Detail | Value |
|---|---|
| **Owning Team** | @platform-core |
| **Slack Channel** | #dev-platform |
| **Source Repository** | [github.com/org/${project_name}](https://github.com/org/${project_name}) |

## Architecture Topology

\`\`\`mermaid
flowchart TD
    Client[\"Client Applications\"] --> Gateway[\"API Gateway\"]
    Gateway --> Services[\"Core Services\"]
    Services --> DB[(\"Primary Datastore\")]
\`\`\`

## Sections

- **Getting Started** — install + quickstart + core concepts
- **Guides** — task-oriented walkthroughs
- **Reference** — CLI, configuration, schema details
"

  if $minimal; then
    echo ""
    echo "docs/ initialized (minimal — no default sections)."
    return 0
  fi

  for entry in "getting-started:install:Install:Get up and running in two minutes.:tutorial" \
               "getting-started:quickstart:Quickstart:A guided walk through the basics.:tutorial" \
               "getting-started:concepts:Concepts:Core ideas you need to know.:explanation"; do
    local section page title desc type
    IFS=':' read -r section page title desc type <<< "$entry"
    [[ -d "docs/$section" ]] || { mkdir -p "docs/$section"; created "docs/$section/"; }
    write_if_missing "docs/${section}/${page}.md" "---
title: ${title}
description: ${desc}
section: ${section}
type: ${type}
status: draft
owner: \"@platform-core\"
last_reviewed: ${TODAY}
updated: ${TODAY}
---

# ${title}

<First paragraph — what this page is for. One sentence is fine.>

## <First subhead>

<Content.>
"
  done

  local extra_dirs="guides reference"
  if [[ "$preset" == "platform" ]]; then
    extra_dirs="architecture services operations reference standards"
  fi

  for d in $extra_dirs; do
    if [[ ! -d "docs/$d" ]]; then
      mkdir -p "docs/$d"
      touch "docs/$d/.gitkeep"
      created "docs/$d/"
    fi
  done

  echo ""
  echo "docs/ initialized."
  echo ""
  echo "Next:"
  echo "  pageworks new <page>          # add a page (asks for type + section)"
  echo "  pageworks new --section <id>  # add a new section"
  echo "  pageworks review              # run quality gate (in your AI agent)"
  echo "  pageworks export mkdocs       # generate mkdocs.yml + GitHub Pages workflow"
}

# ── docs.yaml parsers ────────────────────────────────────────────────────────
docs_yaml_scalar() {
  local manifest="$1" path="$2"
  local root="${path%%.*}" key="${path#*.}"
  awk -v root="$root" -v key="$key" '
    $0 ~ "^"root":" { in_block=1; next }
    in_block && /^[a-zA-Z]/ && !/^  / { in_block=0 }
    in_block && $0 ~ "^[[:space:]]+"key":" {
      sub(/^[[:space:]]+[a-zA-Z_]+:[[:space:]]*/, "")
      sub(/[[:space:]]*#.*$/, "")
      sub(/^["'\'']/, ""); sub(/["'\'']$/, "")
      print
      exit
    }
  ' "$manifest"
}

docs_yaml_renderer_scalar() {
  local manifest="$1" renderer="$2" key="$3"
  awk -v renderer="$renderer" -v key="$key" '
    /^renderers:/ { in_renderers=1; next }
    in_renderers && /^[a-zA-Z]/ && !/^  / { in_renderers=0 }
    in_renderers && $0 ~ "^  "renderer":" { in_block=1; next }
    in_block && /^  [a-zA-Z]/ { in_block=0 }
    in_block && $0 ~ "^    "key":" {
      sub(/^[[:space:]]+[a-zA-Z_]+:[[:space:]]*/, "")
      sub(/[[:space:]]*#.*$/, "")
      sub(/^["'\'']/, ""); sub(/["'\'']$/, "")
      print
      exit
    }
  ' "$manifest"
}

docs_yaml_sections() {
  local manifest="$1"
  awk '
    /^sections:/ { in_sec=1; next }
    in_sec && /^[a-zA-Z]/ && !/^  / { in_sec=0 }
    in_sec && /^  - id:/ {
      if (id != "") print id "\t" title "\t" order "\t" pages
      id=""; title=""; order="999"; pages=""
      id=$0; sub(/^  - id:[[:space:]]*/, "", id); sub(/[[:space:]]*#.*$/, "", id); sub(/[[:space:]]*$/, "", id)
    }
    in_sec && /^[[:space:]]+title:/ {
      title=$0; sub(/^[[:space:]]+title:[[:space:]]*/, "", title); sub(/[[:space:]]*#.*$/, "", title)
      sub(/^["'\'']/, "", title); sub(/["'\'']$/, "", title)
    }
    in_sec && /^[[:space:]]+order:/ {
      order=$0; sub(/^[[:space:]]+order:[[:space:]]*/, "", order); sub(/[[:space:]]*#.*$/, "", order)
    }
    in_sec && /^[[:space:]]+pages:[[:space:]]*\[/ {
      p=$0
      if (match(p, /\[[^\]]*\]/) > 0) { p=substr(p, RSTART+1, RLENGTH-2) } else { p="" }
      gsub(/[[:space:]]/, "", p)
      pages=p
    }
    END {
      if (id != "") print id "\t" title "\t" order "\t" pages
    }
  ' "$manifest" | sort -t$'\t' -k3,3n
}

docs_yaml_extras() {
  local manifest="$1"
  awk '
    /^extras:/ { in_ex=1; next }
    in_ex && /^[a-zA-Z]/ && !/^  / && !/^[[:space:]]*-/ { in_ex=0 }
    in_ex && /^[[:space:]]*-[[:space:]]+/ {
      slug=$0; sub(/^[[:space:]]*-[[:space:]]+/, "", slug); sub(/[[:space:]]*#.*$/, "", slug); sub(/[[:space:]]*$/, "", slug)
      gsub(/^["'\'']|["'\'']$/, "", slug)
      if (slug != "") print slug
    }
  ' "$manifest"
}

docs_page_title() {
  local file="$1" fallback_slug="$2"
  if [[ -f "$file" ]]; then
    local fm_title
    fm_title=$(awk '/^---$/ { c++; if (c==2) exit; next } c==1 && /^title:/ { sub(/^title:[[:space:]]*/, ""); sub(/[[:space:]]*$/, ""); gsub(/^["'\'']|["'\'']$/, ""); print; exit }' "$file")
    if [[ -n "$fm_title" ]]; then
      printf '%s' "$fm_title"
      return
    fi
    local h1
    h1=$(grep -m1 '^# ' "$file" | sed 's/^# *//')
    if [[ -n "$h1" ]]; then
      printf '%s' "$h1"
      return
    fi
  fi
  printf '%s' "$fallback_slug" | awk '{
    n=split($0, parts, "-")
    for (i=1; i<=n; i++) { parts[i]=toupper(substr(parts[i],1,1)) tolower(substr(parts[i],2)) }
    out=parts[1]; for (i=2; i<=n; i++) out=out " " parts[i]; print out
  }'
}

docs_is_pinned() {
  local file="$1"
  [[ -f "$file" ]] || return 1
  head -1 "$file" 2>/dev/null | grep -qE '^(//|#)[[:space:]]*pageworks:[[:space:]]*do-not-overwrite'
}

docs_write_adapter_file() {
  local path="$1" content="$2"
  if docs_is_pinned "$path"; then
    echo "  ⊘  ${path}  (pinned — manual)"
    DOCS_EXPORT_PINNED=$((DOCS_EXPORT_PINNED + 1))
    return 0
  fi
  if [[ -e "$path" ]] && ! $DOCS_EXPORT_FORCE; then
    echo "  ⊘  ${path}  (skipped — use --force)"
    DOCS_EXPORT_SKIPPED=$((DOCS_EXPORT_SKIPPED + 1))
    return 0
  fi
  local existed=false
  [[ -e "$path" ]] && existed=true
  mkdir -p "$(dirname "$path")"
  printf '%s' "$content" > "$path"
  if $existed && $DOCS_EXPORT_FORCE; then
    echo "  ✓  ${path}  (overwritten)"
  else
    echo "  ✓  ${path}"
  fi
  DOCS_EXPORT_WROTE=$((DOCS_EXPORT_WROTE + 1))
}

# ── adapter: mkdocs ──
docs_export_mkdocs() {
  local manifest="$1" out_dir="$2"
  local site_name site_tagline site_url
  site_name="$(docs_yaml_scalar "$manifest" "site.name")"
  site_tagline="$(docs_yaml_scalar "$manifest" "site.tagline")"
  site_url="$(docs_yaml_scalar "$manifest" "site.base_url")"

  local theme palette_primary palette_scheme repo_url edit_uri
  theme="$(docs_yaml_renderer_scalar "$manifest" "mkdocs" "theme")"
  [[ -z "$theme" ]] && theme="material"
  palette_primary="$(docs_yaml_renderer_scalar "$manifest" "mkdocs" "primary")"
  palette_scheme="$(docs_yaml_renderer_scalar "$manifest" "mkdocs" "scheme")"
  repo_url="$(docs_yaml_renderer_scalar "$manifest" "mkdocs" "repo_url")"
  edit_uri="$(docs_yaml_renderer_scalar "$manifest" "mkdocs" "edit_uri")"

  local nav_lines=""
  if [[ -f "docs/index.md" ]]; then
    nav_lines+="  - Home: index.md
"
  fi

  while IFS=$'\t' read -r sec_id sec_title sec_order sec_pages; do
    [[ -z "$sec_id" ]] && continue
    [[ -z "$sec_pages" ]] && continue
    nav_lines+="  - ${sec_title}:
"
    IFS=',' read -r -a page_arr <<< "$sec_pages"
    for page in "${page_arr[@]}"; do
      [[ -z "$page" ]] && continue
      local page_file="docs/${sec_id}/${page}.md"
      local page_title
      page_title="$(docs_page_title "$page_file" "$page")"
      nav_lines+="      - ${page_title}: ${sec_id}/${page}.md
"
    done
  done < <(docs_yaml_sections "$manifest")

  while IFS= read -r extra; do
    [[ -z "$extra" ]] && continue
    local extra_file="docs/${extra}.md"
    local extra_title
    extra_title="$(docs_page_title "$extra_file" "$extra")"
    nav_lines+="  - ${extra_title}: ${extra}.md
"
  done < <(docs_yaml_extras "$manifest")

  local out_file="${out_dir%/}/mkdocs.yml"
  local content="# Generated by pageworks export mkdocs — edits will be preserved unless --force.
# To pin manual edits, add as the first line: # pageworks: do-not-overwrite
site_name: ${site_name:-Documentation}
"
  [[ -n "$site_tagline" ]] && content+="site_description: ${site_tagline}
"
  [[ -n "$site_url" ]] && content+="site_url: ${site_url}
"
  [[ -n "$repo_url" ]] && content+="repo_url: ${repo_url}
"
  [[ -n "$edit_uri" ]] && content+="edit_uri: ${edit_uri}
"
  content+="docs_dir: docs

theme:
  name: ${theme}
"
  local palette_content=""
  if [[ -n "$palette_scheme" || -n "$palette_primary" ]]; then
    palette_content="  palette:
"
    [[ -n "$palette_scheme" ]] && palette_content+="    - scheme: ${palette_scheme}
"
    [[ -n "$palette_primary" ]] && palette_content+="      primary: ${palette_primary}
"
  else
    palette_content="  palette:
    - scheme: default
      primary: indigo
      accent: indigo
      toggle:
        icon: material/brightness-7
        name: Switch to dark mode
    - scheme: slate
      primary: indigo
      accent: indigo
      toggle:
        icon: material/brightness-4
        name: Switch to light mode
"
  fi

  local content="# Generated by pageworks export mkdocs — edits will be preserved unless --force.
# To pin manual edits, add as the first line: # pageworks: do-not-overwrite
site_name: ${site_name:-Documentation}
"
  [[ -n "$site_tagline" ]] && content+="site_description: ${site_tagline}
"
  [[ -n "$site_url" ]] && content+="site_url: ${site_url}
"
  [[ -n "$repo_url" ]] && content+="repo_url: ${repo_url}
"
  [[ -n "$edit_uri" ]] && content+="edit_uri: ${edit_uri}
"
  content+="docs_dir: docs

theme:
  name: ${theme}
${palette_content}  features:
    - navigation.instant
    - navigation.tracking
    - navigation.sections
    - navigation.expand
    - search.suggest
    - search.highlight
    - content.code.copy

extra_css:
  - stylesheets/custom.css

markdown_extensions:
  - admonition
  - toc:
      permalink: true
  - pymdownx.highlight:
      anchor_linenums: true
  - pymdownx.superfences:
      custom_fences:
        - name: mermaid
          class: mermaid
          format: !!python/name:pymdownx.superfences.fence_code_format
  - pymdownx.tabbed:
      alternate_style: true

plugins:
  - search

nav:
${nav_lines}"

  docs_write_adapter_file "$out_file" "$content"

  local css_file="${out_dir%/}/docs/stylesheets/custom.css"
  if [[ ! -f "$css_file" || "$DOCS_EXPORT_FORCE" == "true" ]]; then
    local css_content="/* Pageworks Designer Mode — Custom Theme Overrides */
:root {
  --md-primary-fg-color:        #4f46e5;
  --md-primary-fg-color--light:  #6366f1;
  --md-primary-fg-color--dark:   #4338ca;
  --md-accent-fg-color:         #06b6d4;
  --md-default-bg-color:        #ffffff;
  --md-code-font:               'JetBrains Mono', 'Fira Code', monospace;
}

[data-md-color-scheme=\"slate\"] {
  --md-primary-fg-color:        #6366f1;
  --md-default-bg-color:        #0f172a;
  --md-default-fg-color:        #f8fafc;
}

/* Polished card styling and code block radii */
.md-typeset pre > code {
  border-radius: 6px;
  font-size: 0.85em;
}

.md-typeset .admonition {
  border-radius: 6px;
  box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
}
"
    docs_write_adapter_file "$css_file" "$css_content"
  fi
}

# ── adapter: docusaurus ──
docs_export_docusaurus() {
  local manifest="$1" out_dir="$2"
  local site_name site_tagline site_url
  site_name="$(docs_yaml_scalar "$manifest" "site.name")"
  site_tagline="$(docs_yaml_scalar "$manifest" "site.tagline")"
  site_url="$(docs_yaml_scalar "$manifest" "site.base_url")"

  local org_name proj_name preset repo_url
  org_name="$(docs_yaml_renderer_scalar "$manifest" "docusaurus" "organizationName")"
  proj_name="$(docs_yaml_renderer_scalar "$manifest" "docusaurus" "projectName")"
  preset="$(docs_yaml_renderer_scalar "$manifest" "docusaurus" "preset")"
  [[ -z "$preset" ]] && preset="classic"
  repo_url="$(docs_yaml_renderer_scalar "$manifest" "docusaurus" "repo_url")"
  [[ -z "$repo_url" ]] && repo_url="$(docs_yaml_renderer_scalar "$manifest" "mkdocs" "repo_url")"

  local du_url="https://example.com" du_base="/"
  if [[ -n "$site_url" ]]; then
    du_url="$(printf '%s' "$site_url" | awk -F/ '{print $1"//"$3}')"
    du_base="$(printf '%s' "$site_url" | sed -E "s#^https?://[^/]+##")"
    [[ -z "$du_base" ]] && du_base="/"
    [[ "${du_base: -1}" != "/" ]] && du_base+="/"
  fi

  local sidebar_items=""
  if [[ -f "docs/index.md" ]]; then
    sidebar_items+="    'index',
"
  fi

  while IFS=$'\t' read -r sec_id sec_title sec_order sec_pages; do
    [[ -z "$sec_id" ]] && continue
    [[ -z "$sec_pages" ]] && continue
    sidebar_items+="    {
      type: 'category',
      label: '${sec_title//\'/\\\'}',
      items: ["
    IFS=',' read -r -a page_arr <<< "$sec_pages"
    local first=true
    for page in "${page_arr[@]}"; do
      [[ -z "$page" ]] && continue
      if $first; then first=false; else sidebar_items+=", "; fi
      sidebar_items+="'${sec_id}/${page}'"
    done
    sidebar_items+="],
    },
"
  done < <(docs_yaml_sections "$manifest")

  while IFS= read -r extra; do
    [[ -z "$extra" ]] && continue
    sidebar_items+="    '${extra}',
"
  done < <(docs_yaml_extras "$manifest")

  local config_file="${out_dir%/}/docusaurus.config.js"
  local config_content="// Generated by pageworks export docusaurus — edits will be preserved unless --force.
// To pin manual edits, add as the first line: // pageworks: do-not-overwrite
module.exports = {
  title: '${site_name//\'/\\\'}',
  tagline: '${site_tagline//\'/\\\'}',
  url: '${du_url}',
  baseUrl: '${du_base}',
  onBrokenLinks: 'throw',
  onBrokenMarkdownLinks: 'warn',
"
  [[ -n "$org_name" ]] && config_content+="  organizationName: '${org_name}',
"
  [[ -n "$proj_name" ]] && config_content+="  projectName: '${proj_name}',
"
  config_content+="  markdown: {
    mermaid: true,
  },
  themes: ['@docusaurus/theme-mermaid'],
  presets: [
    ['${preset}', {
      docs: {
        sidebarPath: require.resolve('./sidebars.js'),
        routeBasePath: '/',
      },
      theme: {
        customCss: require.resolve('./src/css/custom.css'),
      },
    }],
  ],
  themeConfig: {
    navbar: {
      title: '${site_name//\'/\\\'}',
"
  if [[ -n "$repo_url" ]]; then
    config_content+="      items: [
        {
          href: '${repo_url}',
          label: 'GitHub',
          position: 'right',
        },
      ],
"
  fi
  config_content+="    },
  },
};
"
  docs_write_adapter_file "$config_file" "$config_content"

  local sidebars_file="${out_dir%/}/sidebars.js"
  local sidebars_content="// Generated by pageworks export docusaurus — edits will be preserved unless --force.
// To pin manual edits, add as the first line: // pageworks: do-not-overwrite
module.exports = {
  docs: [
${sidebar_items}  ],
};
"
  docs_write_adapter_file "$sidebars_file" "$sidebars_content"

  local pkg_file="${out_dir%/}/package.json"
  if [[ ! -f "$pkg_file" ]]; then
    local pkg_content="{
  \"name\": \"docs\",
  \"version\": \"1.0.0\",
  \"private\": true,
  \"scripts\": {
    \"docusaurus\": \"docusaurus\",
    \"start\": \"docusaurus start\",
    \"build\": \"docusaurus build\",
    \"serve\": \"docusaurus serve\"
  },
  \"dependencies\": {
    \"@docusaurus/core\": \"^3.0.0\",
    \"@docusaurus/preset-classic\": \"^3.0.0\",
    \"@docusaurus/theme-mermaid\": \"^3.0.0\",
    \"clsx\": \"^2.0.0\",
    \"react\": \"^18.0.0\",
    \"react-dom\": \"^18.0.0\"
  }
}
"
    docs_write_adapter_file "$pkg_file" "$pkg_content"
  fi

  local css_file="${out_dir%/}/src/css/custom.css"
  if [[ ! -f "$css_file" || "$DOCS_EXPORT_FORCE" == "true" ]]; then
    local css_content="/* Pageworks Designer Mode — Docusaurus Custom Theme */
:root {
  --ifm-color-primary: #4f46e5;
  --ifm-color-primary-dark: #4338ca;
  --ifm-color-primary-darker: #3730a3;
  --ifm-color-primary-darkest: #312e81;
  --ifm-color-primary-light: #6366f1;
  --ifm-color-primary-lighter: #818cf8;
  --ifm-color-primary-lightest: #a5b4fc;
  --ifm-code-font-size: 92%;
  --docusaurus-highlighted-code-line-bg: rgba(0, 0, 0, 0.1);
}

[data-theme='dark'] {
  --ifm-color-primary: #6366f1;
  --ifm-color-primary-dark: #4f46e5;
  --ifm-background-color: #0f172a;
  --ifm-background-surface-color: #1e293b;
  --docusaurus-highlighted-code-line-bg: rgba(0, 0, 0, 0.3);
}
"
    docs_write_adapter_file "$css_file" "$css_content"
  fi
}

# ── adapter: mintlify ──
docs_export_mintlify() {
  local manifest="$1" out_dir="$2"
  local site_name site_tagline site_url
  site_name="$(docs_yaml_scalar "$manifest" "site.name")"
  site_tagline="$(docs_yaml_scalar "$manifest" "site.tagline")"
  site_url="$(docs_yaml_scalar "$manifest" "site.base_url")"

  local primary light dark repo_url
  primary="$(docs_yaml_renderer_scalar "$manifest" "mintlify" "primary")"
  [[ -z "$primary" ]] && primary="#4F46E5"
  light="$(docs_yaml_renderer_scalar "$manifest" "mintlify" "light")"
  [[ -z "$light" ]] && light="#6366F1"
  dark="$(docs_yaml_renderer_scalar "$manifest" "mintlify" "dark")"
  [[ -z "$dark" ]] && dark="#4338CA"
  repo_url="$(docs_yaml_renderer_scalar "$manifest" "mintlify" "repo_url")"
  [[ -z "$repo_url" ]] && repo_url="${site_url:-https://github.com/org/${site_name:-docs}}"

  local nav_groups=""
  local first_group=true

  if [[ -f "docs/index.md" ]]; then
    first_group=false
    nav_groups+="    {
      \"group\": \"Overview\",
      \"pages\": [
        \"docs/index\"
      ]
    }"
  fi

  while IFS=$'\t' read -r sec_id sec_title sec_order sec_pages; do
    [[ -z "$sec_id" ]] && continue
    [[ -z "$sec_pages" ]] && continue
    if $first_group; then
      first_group=false
    else
      nav_groups+=",
"
    fi
    nav_groups+="    {
      \"group\": \"${sec_title//\"/\\\"}\",
      \"pages\": ["
    IFS=',' read -r -a page_arr <<< "$sec_pages"
    local first_page=true
    for page in "${page_arr[@]}"; do
      [[ -z "$page" ]] && continue
      if $first_page; then
        first_page=false
      else
        nav_groups+=", "
      fi
      nav_groups+="\"docs/${sec_id}/${page}\""
    done
    nav_groups+="]
    }"
  done < <(docs_yaml_sections "$manifest")

  while IFS= read -r extra; do
    [[ -z "$extra" ]] && continue
    if $first_group; then
      first_group=false
    else
      nav_groups+=",
"
    fi
    local extra_file="docs/${extra}.md"
    local extra_title
    extra_title="$(docs_page_title "$extra_file" "$extra")"
    nav_groups+="    {
      \"group\": \"${extra_title//\"/\\\"}\",
      \"pages\": [\"docs/${extra}\"]
    }"
  done < <(docs_yaml_extras "$manifest")

  local mint_file="${out_dir%/}/mint.json"
  local mint_content="{
  \"\$schema\": \"https://mintlify.com/schema.json\",
  \"name\": \"${site_name//\"/\\\"}\",
  \"logo\": {
    \"dark\": \"/logo/dark.svg\",
    \"light\": \"/logo/light.svg\"
  },
  \"favicon\": \"/favicon.svg\",
  \"colors\": {
    \"primary\": \"${primary}\",
    \"light\": \"${light}\",
    \"dark\": \"${dark}\",
    \"anchors\": {
      \"from\": \"${primary}\",
      \"to\": \"${light}\"
    }
  },
  \"topbarLinks\": [
    {
      \"name\": \"Documentation\",
      \"url\": \"${repo_url}\"
    }
  ],
  \"topbarCtaButton\": {
    \"name\": \"GitHub\",
    \"url\": \"${repo_url}\"
  },
  \"tabs\": [
    {
      \"name\": \"Documentation\",
      \"url\": \"docs\"
    }
  ],
  \"navigation\": [
${nav_groups}
  ],
  \"footerSocials\": {
    \"github\": \"${repo_url}\"
  }
}
"
  docs_write_adapter_file "$mint_file" "$mint_content"
}

# ── GitHub Pages workflow writer ──
docs_export_workflow() {
  local renderer="$1" out_dir="$2"
  local wf_file="${out_dir%/}/.github/workflows/docs.yml"

  local wf_content
  if [[ "$renderer" == "mkdocs" ]]; then
    wf_content="# Generated by pageworks export mkdocs
name: Deploy docs (MkDocs)
on:
  push:
    branches: [main]
    paths: ['docs/**', 'mkdocs.yml', '.github/workflows/docs.yml']
  pull_request:
    branches: [main]
    paths: ['docs/**', 'mkdocs.yml', '.github/workflows/docs.yml']
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: 'pip'
      - run: pip install mkdocs mkdocs-material
      - run: mkdocs build --strict --site-dir _site
      - uses: actions/upload-pages-artifact@v3
        if: github.ref == 'refs/heads/main'
        with:
          path: _site

  deploy:
    if: github.ref == 'refs/heads/main'
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: \${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
"
  elif [[ "$renderer" == "docusaurus" ]]; then
    wf_content="# Generated by pageworks export docusaurus
name: Deploy docs (Docusaurus)
on:
  push:
    branches: [main]
    paths: ['docs/**', 'docusaurus.config.js', 'sidebars.js', '.github/workflows/docs.yml']
  pull_request:
    branches: [main]
    paths: ['docs/**', 'docusaurus.config.js', 'sidebars.js', '.github/workflows/docs.yml']
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
      - run: npm ci || npm install
      - run: npx docusaurus build
      - uses: actions/upload-pages-artifact@v3
        if: github.ref == 'refs/heads/main'
        with:
          path: build

  deploy:
    if: github.ref == 'refs/heads/main'
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: \${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
"
  elif [[ "$renderer" == "mintlify" ]]; then
    wf_file="${out_dir%/}/.github/workflows/docs-mintlify.yml"
    wf_content="# Generated by pageworks export mintlify
name: Validate Mintlify Docs
on:
  push:
    branches: [main]
    paths: ['docs/**', 'mint.json', '.github/workflows/docs-mintlify.yml']
  pull_request:
    branches: [main]
    paths: ['docs/**', 'mint.json', '.github/workflows/docs-mintlify.yml']
  workflow_dispatch:

jobs:
  validate:
    name: Mintlify Link & Syntax Verification
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - name: Validate Broken Links
        run: npx mintlify broken-links
"
  fi
  docs_write_adapter_file "$wf_file" "$wf_content"
}

# ── docs export orchestrator ──
cmd_export() {
  local renderer=""
  local out_dir="."
  DOCS_EXPORT_FORCE=false
  local no_workflow=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) top_usage; exit 0 ;;
      --out)
        require_value "--out" "${2:-}"
        out_dir="$2"; shift 2 ;;
      --out=*)
        out_dir="${1#--out=}"; shift ;;
      --force)       DOCS_EXPORT_FORCE=true; shift ;;
      --no-workflow) no_workflow=true; shift ;;
      mkdocs|docusaurus|mintlify)
        [[ -n "$renderer" ]] && die "Multiple renderers given: '$renderer' and '$1'. Run one at a time."
        renderer="$1"; shift ;;
      fumadocs)
        die "Renderer '$1' is not shipped — community contributions welcome. See references/renderers.md § Contributing a renderer."
        ;;
      -*) die "Unknown export option: '$1'" ;;
      *)  die "Unknown renderer: '$1'. Supported: mkdocs, docusaurus, mintlify." ;;
    esac
  done

  [[ -z "$renderer" ]] && die "export requires a renderer. Usage: pageworks export <mkdocs|docusaurus|mintlify> [--out path] [--force]"

  local manifest="docs/docs.yaml"
  [[ -f "$manifest" ]] || die "docs/docs.yaml not found. Run 'pageworks init' first."

  DOCS_EXPORT_WROTE=0
  DOCS_EXPORT_SKIPPED=0
  DOCS_EXPORT_PINNED=0

  echo "pageworks export → ${renderer}"
  echo ""
  echo "Generated:"

  case "$renderer" in
    mkdocs)     docs_export_mkdocs     "$manifest" "$out_dir" ;;
    docusaurus) docs_export_docusaurus "$manifest" "$out_dir" ;;
    mintlify)   docs_export_mintlify   "$manifest" "$out_dir" ;;
  esac

  if ! $no_workflow; then
    docs_export_workflow "$renderer" "$out_dir"
  fi

  echo ""
  echo "Summary: ${DOCS_EXPORT_WROTE} written, ${DOCS_EXPORT_SKIPPED} skipped, ${DOCS_EXPORT_PINNED} pinned"
  echo ""

  if (( DOCS_EXPORT_WROTE > 0 )); then
    echo "Next steps:"
    if [[ "$renderer" == "mkdocs" ]]; then
      echo "  1. pip install mkdocs mkdocs-material"
      echo "  2. mkdocs serve                      # local preview at http://127.0.0.1:8000"
    elif [[ "$renderer" == "docusaurus" ]]; then
      echo "  1. npm init -y && npm install @docusaurus/core @docusaurus/preset-classic react react-dom"
      echo "  2. npx docusaurus start              # local preview at http://localhost:3000"
    elif [[ "$renderer" == "mintlify" ]]; then
      echo "  1. npm i -g mintlify (or use npx)"
      echo "  2. npx mintlify dev                  # local preview at http://localhost:3000"
      echo "  3. Deploy: connect repository to Mintlify dashboard (https://dashboard.mintlify.com)"
    fi
    if ! $no_workflow && [[ "$renderer" != "mintlify" ]]; then
      echo "  3. Settings → Pages → Source = GitHub Actions"
      echo "  4. Commit + push to main — the workflow deploys automatically"
    fi
  elif (( DOCS_EXPORT_SKIPPED > 0 || DOCS_EXPORT_PINNED > 0 )); then
    echo "All targets up to date. Use --force to overwrite non-pinned files."
  fi
}

# ── touch ───────────────────────────────────────────────────────────────────
cmd_touch() {
  local target="${1:-}"
  [[ -z "$target" ]] && die "Usage: pageworks touch <path/to/page.md>"

  if [[ ! -f "$target" ]]; then
    if [[ -f "${target}.md" ]]; then
      target="${target}.md"
    elif [[ -f "docs/${target}" ]]; then
      target="docs/${target}"
    elif [[ -f "docs/${target}.md" ]]; then
      target="docs/${target}.md"
    else
      die "File not found: '$1'"
    fi
  fi

  if grep -qE '^last_reviewed:' "$target"; then
    awk -v today="$TODAY" '
      /^last_reviewed:/ { print "last_reviewed: " today; next }
      { print }
    ' "$target" > "${target}.tmp" && mv "${target}.tmp" "$target"
  else
    awk -v today="$TODAY" '
      /^---$/ {
        c++
        if (c == 2) print "last_reviewed: " today
      }
      { print }
    ' "$target" > "${target}.tmp" && mv "${target}.tmp" "$target"
  fi
  echo "  ✓ Touched review timestamp: ${target} → last_reviewed: ${TODAY}"
}

# ── doctor ──────────────────────────────────────────────────────────────────
DOCTOR_ERRORS=0
DOCTOR_WARNINGS=0
DOCTOR_INFO=0
DOCTOR_FIX=false

doctor_emit() {
  local sev="$1" path="$2" msg="$3" fix="${4:-}"
  case "$sev" in
    pass)    echo "  ✅ ${path} — ${msg}" ;;
    info)    echo "  ℹ  ${path} — ${msg}"; DOCTOR_INFO=$((DOCTOR_INFO + 1)) ;;
    warning) echo "  ⚠️  ${path} — ${msg}"; [[ -n "$fix" ]] && echo "     → ${fix}"; DOCTOR_WARNINGS=$((DOCTOR_WARNINGS + 1)) ;;
    error)   echo "  ❌ ${path} — ${msg}"; [[ -n "$fix" ]] && echo "     → ${fix}"; DOCTOR_ERRORS=$((DOCTOR_ERRORS + 1)) ;;
  esac
}

cmd_doctor() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --fix) DOCTOR_FIX=true; shift ;;
      -h|--help) top_usage; exit 0 ;;
      *) die "Unknown doctor option: '$1'" ;;
    esac
  done

  echo "pageworks doctor"
  echo ""

  local docs_dir="docs"
  local manifest="${docs_dir}/docs.yaml"

  if [[ ! -d "$docs_dir" ]]; then
    doctor_emit "info" "docs/" "no docs/ folder — run 'pageworks init' to scaffold one"
    echo ""
    echo "${DOCTOR_ERRORS} error(s), ${DOCTOR_WARNINGS} warning(s), ${DOCTOR_INFO} info"
    exit 0
  fi

  if [[ ! -f "$manifest" ]]; then
    doctor_emit "error" "$manifest" "docs.yaml missing but docs/ exists" "run 'pageworks init' to scaffold it"
    echo ""
    echo "${DOCTOR_ERRORS} error(s), ${DOCTOR_WARNINGS} warning(s), ${DOCTOR_INFO} info"
    exit 1
  fi

  doctor_emit "pass" "$manifest" "docs.yaml present"

  # Validate optional renderers: block
  if grep -qE '^renderers:' "$manifest"; then
    if grep -qE '^renderers:[[:space:]]+[^[:space:]#]' "$manifest"; then
      doctor_emit "error" "$manifest" "renderers: must be a map, got a scalar value" \
        "convert to a map: 'renderers:\\n  mkdocs:\\n    theme: material'"
    elif awk '
      /^renderers:/ { found=1; next }
      found && /^[a-zA-Z]/ && !/^[[:space:]]/ { exit }
      found && /^[[:space:]]*$/ { next }
      found && /^[[:space:]]*-[[:space:]]/ { print "list"; exit }
      found && /^[[:space:]]+[a-zA-Z]/ { exit }
    ' "$manifest" | grep -q list; then
      doctor_emit "error" "$manifest" "renderers: must be a map, got a list" \
        "convert list items to map keys: 'renderers:\\n  mkdocs: ...'"
    else
      doctor_emit "pass" "$manifest" "renderers: block present (valid map)"
      local known_renderers="mkdocs docusaurus mintlify"
      local renderer_keys
      renderer_keys=$(awk '
        /^renderers:/ { in_block=1; next }
        in_block && /^[a-zA-Z]/ && !/^  / { in_block=0 }
        in_block && /^  [a-zA-Z_][a-zA-Z0-9_-]*:/ {
          key=$0
          sub(/^[[:space:]]+/, "", key)
          sub(/:.*$/, "", key)
          print key
        }
      ' "$manifest")
      while IFS= read -r rkey; do
        [[ -z "$rkey" ]] && continue
        if in_list "$rkey" "$known_renderers"; then
          doctor_emit "pass" "$manifest" "renderers.${rkey} recognized"
        else
          doctor_emit "warning" "$manifest" "renderers.${rkey} is not a recognized renderer name" \
            "remove the block, fix the typo, or document it in references/renderers.md (community adapter)"
        fi
      done <<< "$renderer_keys"
    fi
  fi

  # Section/page declaration checks
  local declared_pages
  declared_pages=$(awk '
    /^sections:/ { in_sec=1; next }
    in_sec && /^[a-zA-Z]/ && !/^  / { in_sec=0 }
    in_sec && /^  - id:/ {
      section=$0
      sub(/^  - id:[[:space:]]*/, "", section)
      sub(/[[:space:]]*#.*$/, "", section)
      sub(/[[:space:]]*$/, "", section)
    }
    in_sec && /^[[:space:]]*pages:[[:space:]]*\[/ {
      pages=$0
      if (match(pages, /\[[^\]]*\]/) > 0) {
        pages=substr(pages, RSTART+1, RLENGTH-2)
      } else {
        pages=""
      }
      gsub(/[[:space:]]/, "", pages)
      n=split(pages, arr, ",")
      for (i=1; i<=n; i++) if (arr[i] != "") print section "/" arr[i]
    }
  ' "$manifest")

  local declared_extras
  declared_extras=$(awk '
    /^extras:/ { in_ex=1; next }
    in_ex && /^[a-zA-Z]/ && !/^  / && !/^[[:space:]]*-/ { in_ex=0 }
    in_ex && /^[[:space:]]*-[[:space:]]+/ {
      slug=$0; sub(/^[[:space:]]*-[[:space:]]+/, "", slug); sub(/[[:space:]]*$/, "", slug)
      gsub(/^["'\'']|["'\'']$/, "", slug)
      if (slug != "") print slug
    }
  ' "$manifest")

  local page section_id file_path
  while IFS= read -r entry; do
    [[ -z "$entry" ]] && continue
    section_id="${entry%/*}"
    page="${entry##*/}"
    file_path="${docs_dir}/${section_id}/${page}.md"
    if [[ -f "$file_path" ]]; then
      doctor_emit "pass" "$file_path" "declared page present"
    else
      doctor_emit "error" "$file_path" "page '${page}' declared in docs.yaml but file missing" \
        "create the file or remove the entry from docs.yaml"
    fi
  done <<< "$declared_pages"

  local extra_slug extra_path
  while IFS= read -r extra_slug; do
    [[ -z "$extra_slug" ]] && continue
    extra_path="${docs_dir}/${extra_slug}.md"
    if [[ -f "$extra_path" ]]; then
      doctor_emit "pass" "$extra_path" "declared extra present"
    else
      doctor_emit "error" "$extra_path" "extra '${extra_slug}' declared in docs.yaml but file missing" \
        "create the file or remove the entry from docs.yaml extras:"
    fi
  done <<< "$declared_extras"

  # Orphan check
  shopt -s nullglob
  for section_dir in "$docs_dir"/*/; do
    local sec_id="${section_dir%/}"
    sec_id="${sec_id##*/}"
    [[ "$sec_id" == "."* ]] && continue
    for page_file in "$section_dir"*.md; do
      local page_slug
      page_slug=$(basename "$page_file" .md)
      if ! echo "$declared_pages" | grep -qxF "${sec_id}/${page_slug}"; then
        doctor_emit "warning" "$page_file" "page exists on disk but not declared in docs.yaml (orphan)" \
          "add to docs.yaml ${sec_id}.pages or delete the file"
      fi
    done
  done
  for page_file in "$docs_dir"/*.md; do
    [[ -f "$page_file" ]] || continue
    local page_slug
    page_slug=$(basename "$page_file" .md)
    [[ "$page_slug" == "index" ]] && continue
    if ! echo "$declared_extras" | grep -qxF "$page_slug"; then
      doctor_emit "warning" "$page_file" "top-level page exists on disk but not in docs.yaml extras: (orphan)" \
        "add to docs.yaml extras: or move into a section folder"
    fi
  done
  shopt -u nullglob

  # Hierarchy depth check (max 3 levels: docs -> section -> page.md)
  while IFS= read -r deep_file; do
    [[ -z "$deep_file" ]] && continue
    doctor_emit "error" "$deep_file" "folder hierarchy depth exceeds 3 levels (keep structure shallow)" \
      "move to a flat section folder under docs/ and group in docs.yaml"
  done < <(find "$docs_dir" -mindepth 3 -name "*.md" 2>/dev/null || true)

  # Frontmatter & Content validation
  local required_fields="title description section status updated"
  local valid_classes="tutorial how-to reference explanation adr service-catalog runbook postmortem migration troubleshooting cookbook design-spec guide spec overview"
  
  shopt -s nullglob
  for page_file in "$docs_dir"/*.md "$docs_dir"/*/*.md; do
    [[ -f "$page_file" ]] || continue
    local rel_page="${page_file#$docs_dir/}"
    local p_sec=""
    [[ "$rel_page" == *"/"* ]] && p_sec="${rel_page%/*}"
    local p_slug
    p_slug=$(basename "$page_file" .md)

    if ! head -1 "$page_file" | grep -q '^---$'; then
      if $DOCTOR_FIX; then
        local p_title
        p_title="$(docs_page_title "$page_file" "$p_slug")"
        local new_content="---
title: ${p_title}
description: Documentation for ${p_title}.
section: ${p_sec}
type: explanation
status: draft
owner: \"@platform-core\"
last_reviewed: ${TODAY}
updated: ${TODAY}
---

$(cat "$page_file")"
        printf '%s\n' "$new_content" > "$page_file"
        doctor_emit "pass" "$page_file" "injected missing frontmatter block (--fix applied)"
      else
        doctor_emit "error" "$page_file" "missing frontmatter delimiter" \
          "add proper frontmatter block (or run 'pageworks doctor --fix')"
        continue
      fi
    fi

    local fm
    fm=$(awk '/^---$/ { count++; if (count == 2) exit; next } count == 1' "$page_file")
    
    for field in $required_fields; do
      if ! echo "$fm" | grep -qE "^${field}:"; then
        if $DOCTOR_FIX; then
          local field_val=""
          case "$field" in
            title) field_val="$(docs_page_title "$page_file" "$p_slug")" ;;
            description) field_val="Documentation for $(docs_page_title "$page_file" "$p_slug")." ;;
            section) field_val="${p_sec}" ;;
            status) field_val="draft" ;;
            updated) field_val="${TODAY}" ;;
          esac
          # Inject field into frontmatter right before the closing ---
          awk -v field="$field" -v val="$field_val" '
            /^---$/ {
              c++
              if (c == 2) {
                print field ": " val
              }
            }
            { print }
          ' "$page_file" > "${page_file}.tmp" && mv "${page_file}.tmp" "$page_file"
          fm=$(awk '/^---$/ { count++; if (count == 2) exit; next } count == 1' "$page_file")
          doctor_emit "pass" "$page_file" "repaired missing '${field}:' field (--fix applied)"
        else
          doctor_emit "error" "$page_file" "missing required frontmatter field: ${field}" \
            "add '${field}:' to frontmatter (or run 'pageworks doctor --fix')"
        fi
      fi
    done

    # Type field check (info if missing, info for custom types — classes are an extensible baseline)
    if ! echo "$fm" | grep -qE "^type:"; then
      doctor_emit "info" "$page_file" "missing 'type:' frontmatter (recommended baseline: tutorial|how-to|reference|explanation|adr|service-catalog|runbook|postmortem|migration|troubleshooting|cookbook|design-spec)"
    else
      local ptype
      ptype=$(echo "$fm" | awk '/^type:/ { sub(/^type:[[:space:]]*/, ""); sub(/[[:space:]]*#.*$/, ""); gsub(/^["'\'']|["'\'']$/, ""); print; exit }')
      if [[ -n "$ptype" ]] && ! in_list "$ptype" "$valid_classes"; then
        doctor_emit "info" "$page_file" "custom page type '${ptype}' declared (extensible baseline: tutorial|how-to|reference|explanation|adr|service-catalog|runbook|postmortem|migration|troubleshooting|cookbook|design-spec)"
      fi
    fi

    # 180-Day Stale Content Check
    local last_rev
    last_rev=$(echo "$fm" | awk '/^(last_reviewed|updated):/ { sub(/^[a-zA-Z_]+:[[:space:]]*/, ""); sub(/[[:space:]]*#.*$/, ""); gsub(/^["'\'']|["'\'']$/, ""); print; exit }')
    if [[ -n "$last_rev" && "$last_rev" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
      local days_old
      days_old=$(awk -v today="$TODAY" -v date="$last_rev" '
        function to_days(ymd,  arr, y, m, d) {
          split(ymd, arr, "-")
          y = arr[1] + 0; m = arr[2] + 0; d = arr[3] + 0
          if (m <= 2) { y -= 1; m += 12 }
          return int(365.25 * y) + int(30.6001 * (m + 1)) + d
        }
        BEGIN { print to_days(today) - to_days(date) }
      ')
      if (( days_old > 180 )); then
        doctor_emit "warning" "$page_file" "content has not been reviewed in > 180 days (${days_old} days old — stale)" \
          "verify accuracy against current code and update 'last_reviewed: ${TODAY}' or run 'pageworks touch ${page_file}'"
      fi
    fi

    # Layer 1 Mechanical Drift Check: synced_from:
    local synced_path
    synced_path=$(echo "$fm" | awk '/^synced_from:/ { sub(/^synced_from:[[:space:]]*/, ""); sub(/[[:space:]]*#.*$/, ""); gsub(/^["'\'']|["'\'']$/, ""); print; exit }')
    if [[ -n "$synced_path" ]]; then
      local page_dir_base
      page_dir_base="$(dirname "$page_file")"
      local synced_resolved
      if [[ "$synced_path" == /* ]]; then
        synced_resolved=".${synced_path}"
      else
        synced_resolved="${page_dir_base}/${synced_path}"
      fi

      if [[ ! -e "$synced_resolved" ]]; then
        doctor_emit "error" "$page_file" "synced_from target '${synced_path}' does not exist on disk" \
          "verify path or remove 'synced_from:' in frontmatter"
      else
        if command -v git &>/dev/null && git rev-parse --is-inside-work-tree &>/dev/null; then
          local upstream_date
          upstream_date=$(git log -1 --format=%cs -- "$synced_resolved" 2>/dev/null || true)
          if [[ -n "$upstream_date" && -n "$last_rev" && "$last_rev" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
            local drift_days
            drift_days=$(awk -v up="$upstream_date" -v rev="$last_rev" '
              function to_days(ymd,  arr, y, m, d) {
                split(ymd, arr, "-")
                y = arr[1] + 0; m = arr[2] + 0; d = arr[3] + 0
                if (m <= 2) { y -= 1; m += 12 }
                return int(365.25 * y) + int(30.6001 * (m + 1)) + d
              }
              BEGIN { print to_days(up) - to_days(rev) }
            ')
            if (( drift_days > 0 )); then
              doctor_emit "warning" "$page_file" "upstream source '${synced_path}' modified in git since last review (${drift_days} day(s) drift)" \
                "reconcile page content with upstream changes, then run 'pageworks touch ${page_file}'"
            fi
          fi
        fi
      fi
    fi

    # Internal Markdown Link Check
    local page_dir
    page_dir="$(dirname "$page_file")"
    local raw_links
    raw_links=$(awk '
      {
        line = $0
        while (match(line, /\[[^\]]*\]\(([^)#[:space:]]+)(#[^)]*)?\)/) > 0) {
          matched = substr(line, RSTART, RLENGTH)
          sub(/^\[[^\]]*\]\(/, "", matched)
          sub(/\).*$/, "", matched)
          sub(/#.*$/, "", matched)
          sub(/\?.*$/, "", matched)
          if (matched != "" && matched !~ /^(https?:|mailto:|ftp:|#|<)/) {
            print matched
          }
          line = substr(line, RSTART + RLENGTH)
        }
      }
    ' "$page_file")

    while IFS= read -r link_target; do
      [[ -z "$link_target" ]] && continue
      local target_resolved
      if [[ "$link_target" == /* ]]; then
        target_resolved=".${link_target}"
      else
        target_resolved="${page_dir}/${link_target}"
      fi
      if [[ ! -e "$target_resolved" ]]; then
        doctor_emit "error" "$page_file" "broken internal link to '${link_target}'" \
          "ensure the target file exists or update the link URL"
      fi
    done <<< "$raw_links"

  done
  shopt -u nullglob

  echo ""
  echo "${DOCTOR_ERRORS} error(s), ${DOCTOR_WARNINGS} warning(s), ${DOCTOR_INFO} info"
  exit $(( DOCTOR_ERRORS > 0 ? 1 : 0 ))
}

# ── skill-verb stubs ──────────────────────────────────────────────────────────
skill_verb_message() {
  local verb="$1" description="$2"
  cat >&2 <<EOF
'pageworks ${verb}' is a skill verb — run it inside your AI agent (Claude Code, Codex, Antigravity).
${description}
EOF
  exit 0
}

# ── main ──────────────────────────────────────────────────────────────────────
main() {
  local subcmd="${1:-}"

  case "$subcmd" in
    --version|-v|version)
      echo "pageworks ${PAGEWORKS_VERSION}"
      exit 0
      ;;
    ""|--help|-h|help)
      top_usage; exit 0
      ;;
    init)     shift; cmd_init     "$@" ;;
    export)   shift; cmd_export   "$@" ;;
    doctor)   shift; cmd_doctor   "$@" ;;
    touch)    shift; cmd_touch    "$@" ;;
    ack)      shift; cmd_touch    "$@" ;;
    sync-ack) shift; cmd_touch    "$@" ;;
    new)
      shift
      skill_verb_message "new" "Scaffolds a page from the extensible baseline (asks for class format + section + title)."
      ;;
    review)
      shift
      skill_verb_message "review <page>" "Micro quality gate — evaluates single page prose, Diátaxis quadrant fit, runnable snippets, and formatting."
      ;;
    status)
      shift
      skill_verb_message "status" "Briefing of docs/ state — 6 topic categories, page classes, stale review alerts."
      ;;
    audit)
      shift
      skill_verb_message "audit" "Macro drift detection — audits entire docs/ tree for 180-day staleness, broken links, and upstream git drift."
      ;;
    *)
      die "Unknown command: '${subcmd}'.
CLI verbs:   init | export | doctor | touch
Skill verbs (run via /pageworks in your AI agent): new | review | status | audit
Run 'pageworks --help' for usage."
      ;;
  esac
}

main "$@"
