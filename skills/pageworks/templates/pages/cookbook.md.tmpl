## Runnable Implementation

=== "Node.js (Express)"

    ```typescript
    import express from 'express';
    import crypto from 'crypto';

    const app = express();
    const WEBHOOK_SECRET = process.env.WEBHOOK_SECRET || 'whsec_test';

    app.post('/webhooks', express.raw({ type: 'application/json' }), (req, res) => {
      const signature = req.headers['x-signature-sha256'] as string;
      const expected = crypto
        .createHmac('sha256', WEBHOOK_SECRET)
        .update(req.body)
        .digest('hex');

      if (!crypto.timingSafeEqual(Buffer.from(signature || ''), Buffer.from(expected))) {
        return res.status(400).send('Invalid webhook signature');
      }

      const event = JSON.parse(req.body.toString());
      console.log('Verified event received:', event.id);

      // Acknowledge immediately before executing long-running async jobs
      res.status(200).json({ received: true });
    });

    app.listen(3000, () => console.log('Receiver running on :3000'));
    ```

=== "Python (FastAPI)"

    ```python
    import hmac
    import hashlib
    import os
    from fastapi import FastAPI, Request, HTTPException, Header

    app = FastAPI()
    WEBHOOK_SECRET = os.getenv("WEBHOOK_SECRET", "whsec_test").encode()

    @app.post("/webhooks")
    async def handle_webhook(
        request: Request,
        x_signature_sha256: str = Header(None)
    ):
        body = await request.body()
        expected = hmac.new(WEBHOOK_SECRET, body, hashlib.sha256).hexdigest()

        if not x_signature_sha256 or not hmac.compare_digest(x_signature_sha256, expected):
            raise HTTPException(status_code=400, detail="Invalid signature")

        event = await request.json()
        print(f"Verified event received: {event.get('id')}")
        return {"received": True}
    ```

